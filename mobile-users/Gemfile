source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'

# json 3.0 removed the `quirks_mode` keyword from JSON.generate, and
# activesupport 7.2 still passes it:
#
#   activesupport/lib/active_support/json/encoding.rb:110
#     ::JSON.generate(jsonified, quirks_mode: true, max_nesting: false)
#
# Ruby 4 ships json 3.x, so `pod install` dies with
# "ArgumentError - unknown keyword: quirks_mode" the moment anything calls
# to_json — which Expo's autolinking does for every pod it resolves
# (expo-modules-autolinking/scripts/ios/cocoapods/sandbox.rb:29).
#
# Pinned rather than upgrading activesupport, because the activesupport version
# is itself pinned by the cocoapods/xcodeproj constraints above. Drop this once
# an activesupport that has stopped passing quirks_mode is resolvable here.
gem 'json', '< 3'
