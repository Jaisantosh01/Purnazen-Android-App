# Copy to .env and adjust. All client-side vars must be prefixed EXPO_PUBLIC_.
#
# NOTE: `react-native start` does NOT load .env — only `expo start` does. For the
# normal RN dev flow, set the BASE_URL fallback in src/config/index.js instead.
#
# Backend base URL.
#   USB device / emulator (recommended): http://localhost:5000  (needs `adb reverse tcp:5000 tcp:5000`)
#   Emulator without adb reverse:        http://10.0.2.2:5000
#   Physical device over Wi-Fi:          http://<your-machine-LAN-IP>:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
