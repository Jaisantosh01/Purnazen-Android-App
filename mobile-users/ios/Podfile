require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

MIN_IOS = '16.4'
platform :ios, MIN_IOS
prepare_react_native_project!

# Required by the `use_frameworks! :linkage => :static` below: it tells
# react-native-firebase to build its own pods as static frameworks to match.
$RNFirebaseAsStaticFramework = true

# Static FRAMEWORKS, not static libraries — and this is not a preference.
#
# FirebaseAuth is a Swift pod. Firebase's umbrella header does this:
#
#     #if __has_include("FirebaseAuth-umbrella.h")
#       ...
#       #import <FirebaseAuth/FirebaseAuth-Swift.h>
#     #endif
#
# Built as a static LIBRARY, CocoaPods symlinks the umbrella header into
# Pods/Headers/Public/FirebaseAuth/ — so the guard passes — but the generated
# Swift interop header is published to a sibling "Swift Compatibility Header"
# directory and exposed only through a separate `FirebaseAuth.Swift` module. So
# `<FirebaseAuth/FirebaseAuth-Swift.h>` does not resolve, and every target that
# imports <Firebase/Firebase.h> without depending on Auth fails to compile.
# RNFBMessaging is exactly that target:
#
#     Pods/Headers/Private/Firebase/Firebase.h:40:15:
#       error: 'FirebaseAuth/FirebaseAuth-Swift.h' file not found
#
# Built as a FRAMEWORK, the generated header lands inside
# FirebaseAuth.framework/Headers/ and the import resolves. This is the
# configuration Firebase's umbrella header assumes, and the one Firebase and
# react-native-firebase document for Swift products.
#
# Overridable for debugging: USE_FRAMEWORKS=dynamic pod install.
linkage = (ENV['USE_FRAMEWORKS'] || 'static').to_sym

# React Native's podspecs gate their entire use_frameworks! support on this
# variable being present in the environment — see resolve_use_frameworks in
# react-native/scripts/cocoapods/utils.rb, which returns early unless it is set.
# Calling use_frameworks! without it leaves React-Core's headers non-modular, so
# <React/*.h> resolves to plain headers that no clang module owns.
ENV['USE_FRAMEWORKS'] = linkage.to_s

# React Native 0.85 ships a prebuilt React.xcframework by default. Its headers
# are reached through a VFS overlay and a generated `module React` map that Expo
# injects as -fmodule-map-file. Explicitly-built Clang modules do not inherit
# that flag, so while building a pod that is itself a framework module — e.g.
# RNFBApp, whose public headers import <React/RCTBridgeModule.h> — Clang finds
# the header but cannot attribute it to any module:
#
#   While building module 'RNFBApp':
#   RNFBSharedUtils.h:22:9: error: include of non-modular header inside framework
#     module 'RNFBApp.RNFBSharedUtils': '.../React_Core/React/RCTBridgeModule.h'
#     [-Werror,-Wnon-modular-include-in-framework-module]
#
# Building React Native from source makes React-Core an ordinary pod, so
# use_frameworks! gives it a real `framework module React` that Clang discovers
# through the framework search paths in every context, module builds included.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

Pod::UI.puts "Configuring Pods with #{linkage}ally linked frameworks"
use_frameworks! :linkage => linkage

target 'wellness' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 refuses any target whose deployment target is below iOS 15 —
    # an error now, a warning in Xcode 26. Several pods still declare 9.0–13.0,
    # mostly for their privacy-manifest resource bundles (PromisesObjC,
    # GoogleUtilities, nanopb, AsyncStorage, react-native-image-picker). The app
    # itself targets 16.4, so nothing is lost by raising them to match.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        current = c.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(MIN_IOS)
          c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_IOS
        end
      end
    end
  end
end
