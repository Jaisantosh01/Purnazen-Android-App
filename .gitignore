# ===== BACKEND (FastAPI) =====
backend/venv/
backend/venv*/
backend/.env
backend/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/instance/
backend/.flaskenv

# Trained-model artifacts (large; produced by backend/ml training, dropped in by the user)
backend/app/ai/models/*.onnx
backend/app/ai/face_landmarker.task
# ML training scratch (datasets, checkpoints, runs) — keep the code, ignore the data
backend/ml/data/
backend/ml/runs/
backend/ml/checkpoints/
backend/ml/*.pt
backend/ml/*.onnx

# ===== FRONTEND (React Native apps: mobile-users, mobile-doctors) =====
# Patterns apply to every mobile-* app via the glob prefix.
mobile-*/node_modules/
mobile-*/.env
mobile-*/.env.local
mobile-*/npm-debug.log
mobile-*/yarn-error.log
mobile-*/.metro-health-check*
mobile-*/coverage/

# Android
mobile-*/android/.gradle
mobile-*/android/app/build
mobile-*/android/build
mobile-*/android/.idea
mobile-*/android/local.properties
mobile-*/android/.cxx/
mobile-*/android/*.keystore
!mobile-*/android/app/debug.keystore

# Upload signing keystore + generated provisioning secrets — never commit
*.keystore
*.jks
keystore.b64
.keystore-password.txt
scripts/.azure*.env
scripts/.provision*.log

# Local Docker APK build output + caches
/release/
.docker-cache/

# iOS
mobile-*/ios/build/
mobile-*/ios/DerivedData/
mobile-*/ios/Pods/
mobile-*/ios/Podfile.lock
mobile-*/ios/*.xcuserstate
mobile-*/ios/.xcode.env.local

# ===== GENERAL =====
.DS_Store
Thumbs.db
.env
.env.local
.vscode/
.idea/
*.log
*.log.err
*.log.out
__pycache__/

# SQLite dev fallback
backend/*.db
backend/uploads/*
screenshots/
app-screen.png
backend/server.log*

# Python virtual environments
**/.venv/
**/venv/
