# Trained-model artifacts (large; produced by backend/ml training, dropped in by the user)
backend/app/ai/models/*.onnx
backend/app/ai/face_landmarker.task
# ML training scratch (datasets, checkpoints, runs) — keep the code, ignore the data
backend/ml/data/
backend/ml/runs/
backend/ml/checkpoints/
backend/ml/*.pt
backend/ml/*.onnx

