# ===== BACKEND (FastAPI) =====
backend/venv/
backend/venv*/
backend/.venv/
backend/.venv*/
backend/.purnazen/
backend/.env
backend/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/instance/
backend/.flaskenv

# Trained-model artifacts (large; produced by backend/ml training, dropped in by the user)
backend/app/ai/models/*.onnx
backend/app/ai/models/tongue_yolo.pt
backend/app/ai/face_landmarker.task
# ML training scratch (datasets, checkpoints, runs) — keep the code, ignore the data
backend/ml/data/
backend/ml/runs/
backend/ml/checkpoints/
backend/ml/*.pt
backend/ml/*.onnx

# ===== FRONTEND (React Native apps: mobile-users, mobile-doctors) =====
# Patterns apply to every mobile-* app via the glob prefix.
mobile-*/node_modules/
mobile-*/.env
mobile-*/.env.local
mobile-*/npm-debug.log
mobile-*/yarn-error.log
mobile-*/.metro-health-check*
mobile-*/coverage/

# Android
mobile-*/android/.gradle
mobile-*/android/app/build
mobile-*/android/build
mobile-*/android/.idea
mobile-*/android/local.properties
mobile-*/android/.cxx/
mobile-*/android/*.keystore
!mobile-*/android/app/debug.keystore

# Upload signing keystore + generated provisioning secrets — never commit
*.keystore
*.jks
keystore.b64
.keystore-password.txt
scripts/.azure*.env
scripts/.provision*.log

# Local Docker APK build output + caches, iOS archives (scripts/archive-ios.sh)
/release/
/build/
.docker-cache/

# iOS
mobile-*/ios/build/
mobile-*/ios/DerivedData/
mobile-*/ios/Pods/
# Podfile.lock is deliberately NOT ignored. It pins the exact pod versions the
# build was verified against; ignoring it means every machine and every CI run
# resolves its own set, which is how "works on my Mac" happens. Pods/ stays
# ignored — that is the installed output, not the lock.
mobile-*/ios/*.xcworkspace
mobile-*/ios/*.xcuserstate
mobile-*/ios/.xcode.env.local
mobile-*/ios/xcuserdata/
mobile-*/ios/**/xcuserdata/

# ===== GENERAL =====
.DS_Store
Thumbs.db
.env
.env.local
.vscode/
.idea/
*.log
*.log.err
*.log.out
__pycache__/

# Local build logs (scripts/build-ios.sh writes here)
build-logs/

# SQLite dev fallback
backend/*.db
backend/uploads/*
screenshots/
app-screen.png
backend/server.log*

