# Copy to .env and adjust. All client-side vars must be prefixed EXPO_PUBLIC_.

# Backend base URL (shared with the patient app — same FastAPI server).
#   Android emulator: http://10.0.2.2:5000 (default if unset)
#   Physical device:  http://<your-machine-LAN-IP>:5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
