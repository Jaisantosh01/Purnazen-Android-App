# Use a long random string (32+ chars) in production
SECRET_KEY=your_secret_key_change_this_in_production_32chars
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production_32chars

# PostgreSQL for real environments; omit to fall back to local SQLite (./wellness.db)
DATABASE_URL=postgresql://user:password@localhost:5433/database_name

# Optional: Redis for cross-worker rate limits + token blocklist cache.
# Omit to use in-memory rate limits and DB-only blocklist (fine for local dev).
# REDIS_URL=redis://localhost:6379/0

# CORS: comma-separated origins. "*" (default) is for dev only — restrict in production.
# CORS_ORIGINS=https://app.purnazen.com,https://admin.purnazen.com

# Rate limits (per client IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=3/minute
# RATE_LIMIT_REFRESH=10/minute

# Optional overrides
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Razorpay (use rzp_test_* keys for the sandbox). Omit both to run the local
# sandbox mode: orders are generated locally, no external calls are made.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Cloudinary — for face scan image storage (Sprint 2+) and session videos.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Social authentication (Sprint 5)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# APPLE_APP_ID=com.your.bundleid
