# Use a long random string (32+ chars) in production
# Use the follwoing command to generate a random string in Linux or MacOS:
# openssl rand -hex 32
# python -c "import secrets; print(secrets.token_hex(32))"
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate a random string in Windows PowerShell:
# [System.BitConverter]::ToString((New-Object System.Security.Cryptography.RNGCrypto
SECRET_KEY=your_secret_key_change_this_in_production_32chars
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production_32chars

# PostgreSQL for real environments; omit to fall back to local SQLite (./wellness.db)
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database_name>

#Azure credentials for blob storage
AZURE_STORAGE_ACCOUNT_NAME=azure_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=azure_storage_account_key
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=azure_storage_account_name;AccountKey=azure_storage_account_key;EndpointSuffix=core.windows.net
# Program/session videos only — the admin video browser lists this whole container.
AZURE_BLOB_CONTAINER_NAME=azure_blob_container_name
# User uploads (face scan images). Must be a DIFFERENT container from the videos
# one, or scans show up in the admin video browser. Defaults to "uploads".
AZURE_SCANS_CONTAINER_NAME=uploads
# Profile photos. Also must differ from the videos container. Created on the
# first avatar upload if it doesn't exist yet. Defaults to "avatars".
AZURE_AVATARS_CONTAINER_NAME=avatars

# development | staging | production. The Docker image sets this to
# "production", which turns on the startup checks in app/core/config.py: a
# production process refuses to boot on the placeholder SECRET_KEY /
# JWT_SECRET_KEY above, or on a wildcard CORS policy. Leave it unset (or set it
# to development) for local work.
# ENVIRONMENT=development

# Redis for cross-replica rate limits + token blocklist cache.
# REQUIRED in any environment running more than one replica: without it every
# replica keeps its own counters, so the effective limit is N x the configured
# value. Startup logs a warning when rate limiting is on and this is empty.
# REDIS_URL=redis://localhost:6379/0

# CORS: comma-separated origins. Empty by default, which means no cross-origin
# browser access at all — correct for an API served only to the mobile apps.
# "*" is REJECTED in production (and was always a no-op alongside credentialed
# requests). List real origins when a browser client needs one.
# CORS_ORIGINS=https://app.purnazen.com,https://admin.purnazen.com

# Rate limits (per client IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=3/minute
# RATE_LIMIT_REFRESH=10/minute

# Optional overrides
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Razorpay (use rzp_test_* keys for the sandbox). Omit both to run the local
# sandbox mode: orders are generated locally, no external calls are made.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Cloudinary — for face scan image storage (Sprint 2+) and session videos.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Google Calendar / Meet — service account JSON key (base64-encoded). When empty,
# video-consultation bookings skip Meet link creation.
# GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_json_here

# Firebase — ONE base64-encoded service account key powers both FCM push and
# social sign-in (Google/GitHub via Firebase Auth). See docs/FIREBASE.md.
# FIREBASE_SERVICE_ACCOUNT_JSON=base64_encoded_json_here
# Optional override; normally derived from the service account JSON.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Where each app's "Update" button leads, per platform (docs/DISTRIBUTION.md).
# Change a private channel (unlisted App Store link, TestFlight public link)
# without shipping a new build. Omit to use the store listings built into the apps.
# STORE_LINKS_JSON={"mobile-users":{"android":"https://play.google.com/store/apps/details?id=com.purnazen"},"mobile-doctors":{"ios":"https://testflight.apple.com/join/XXXXXXXX"}}
